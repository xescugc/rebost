{{define "main"}}
  <!DOCTYPE html>
  <html lang="en">
    <head>
      <meta charset="UTF-8" />
      <meta name="viewport" content="width=device-width, initial-scale=1.0" />
      <title>Rebost</title>
      <link rel="preconnect" href="https://fonts.googleapis.com" />
      <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
      <link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet" />
      <link href="/css/bootstrap.min.css" rel="stylesheet" />
      <link href="/css/custom.css" rel="stylesheet" />
      <link rel="icon" href="/img/favicon.svg" type="image/svg+xml" />
    </head>

    <body>
      <nav class="navbar">
        <div class="navbar-inner">
          <a class="navbar-brand" href="/">
            <img src="/img/favicon.svg" alt="Rebost" height="30" />
            <span class="brand-name">Rebost</span>
          </a>
          <div class="nav-status">
            <span class="status-dot active"></span>
            <span>System Online</span>
          </div>
        </div>
      </nav>

      {{ if ne .Err nil }}
        <div class="alert-banner" role="alert">
          <span>⚠</span>
          {{ .Err }}
        </div>
      {{ end }}

      {{template "content" .}}

      <script type="text/javascript" src="/js/bootstrap.bundle.min.js"></script>
    </body>
  </html>
{{end}}
